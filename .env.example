# KalySwap frontend — copy to .env.local. Every NEXT_PUBLIC_ variable the code reads is listed here.

# AlchemyPay on-ramp widget app id.
NEXT_PUBLIC_ALCHEMYPAY_APP_ID=""

# Backend GraphQL API base (default: same-origin /api).
NEXT_PUBLIC_API_URL=""

# Optional override; otherwise thirdweb RPC edge, then public fallback.
NEXT_PUBLIC_ARBITRUM_RPC_URL=""

# Optional override; otherwise thirdweb RPC edge, then public fallback.
NEXT_PUBLIC_BSC_RPC_URL=""

# KalyChain explorer. Default testnet.kalyscan.io — CUT DAY: switch to the production URL.
NEXT_PUBLIC_KALYCHAIN_EXPLORER_URL=""

# KalyChain 3890 RPC. Default mainrpc.kalychain.io — CUT DAY: switch to the production URL.
NEXT_PUBLIC_KALYCHAIN_RPC_URL=""

# Optional override; otherwise thirdweb RPC edge, then public fallback.
NEXT_PUBLIC_POLYGON_RPC_URL=""

# Optional override of the KalyStaking address (default from src/config).
NEXT_PUBLIC_STAKING_CONTRACT_ADDRESS=""

# thirdweb browser client id (in-app wallets + paid RPC for Arbitrum/BSC/Polygon). NEVER put the secret key in a NEXT_PUBLIC_ var.
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=""

# V3 DEX subgraph (default https://app.kalyswap.io/subgraphs/name/v3-subgraph-kmt).
NEXT_PUBLIC_V3_SUBGRAPH_URL=""

# WalletConnect Cloud project id.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""
